<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<PMML version="4.2" xsi:schemaLocation="http://www.dmg.org/PMML-4_2 http://www.dmg.org/v4-2-1/pmml-4-2.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.dmg.org/PMML-4_2">
  <Header/>
  <DataDictionary numberOfFields="5">
    <DataField name="monthsInService" optype="continuous" dataType="double"/>
    <DataField name="equipmentType" optype="categorical" dataType="string">
      <Value value="PRESS" />
      <Value value="OVEN" />
      <Value value="CONVEYOR" />
      <Value value="PUMP" />
      <Value value="COMPRESSOR" />
    </DataField>
    <DataField name="operatingEnvironment" optype="categorical" dataType="string">
      <Value value="OUTDOOR" />
      <Value value="COASTAL" />
      <Value value="INDOOR" />
    </DataField>
    <DataField name="inspectionPassed" optype="categorical" dataType="boolean"/>
    <DataField name="maintenancePriorityScore" optype="continuous" dataType="double" />
  </DataDictionary>
  <Scorecard modelName="Maintenance Priority Score" useReasonCodes="true" isScorable="true" functionName="regression" baselineScore="0.0" initialScore="0.345">
    <MiningSchema>
      <MiningField name="monthsInService" usageType="active" invalidValueTreatment="asMissing"/>
      <MiningField name="equipmentType" usageType="active" invalidValueTreatment="asMissing"/>
      <MiningField name="operatingEnvironment" usageType="active" invalidValueTreatment="asMissing"/>
      <MiningField name="inspectionPassed" usageType="active" invalidValueTreatment="asMissing"/>
      <MiningField name="maintenancePriorityScore" usageType="predicted"/>
    </MiningSchema>
    <Output>
      <OutputField name="calculatedScore" displayName="Maintenance Priority Score" dataType="double" feature="predictedValue" targetField="maintenancePriorityScore"/>
    </Output>
    <Characteristics>
      <Characteristic name="ServiceLifeScore" baselineScore="0.0" reasonCode="LIFE">
        <Extension name="cellRef" value="$B$8"/>
        <Attribute partialScore="10.0">
          <Extension name="cellRef" value="$C$10"/>
          <SimplePredicate field="monthsInService" operator="lessOrEqual" value="5"/>
        </Attribute>
        <Attribute partialScore="30.0" reasonCode="CX1">
          <Extension name="cellRef" value="$C$11"/>
          <CompoundPredicate booleanOperator="and">
            <SimplePredicate field="monthsInService" operator="greaterOrEqual" value="5"/>
            <SimplePredicate field="monthsInService" operator="lessThan" value="12"/>
          </CompoundPredicate>
        </Attribute>
        <Attribute partialScore="40.0" reasonCode="CX2">
          <Extension name="cellRef" value="$C$12"/>
          <CompoundPredicate booleanOperator="and">
            <SimplePredicate field="monthsInService" operator="greaterOrEqual" value="13"/>
            <SimplePredicate field="monthsInService" operator="lessThan" value="44"/>
          </CompoundPredicate>
        </Attribute>
        <Attribute partialScore="25.0">
          <Extension name="cellRef" value="$C$13"/>
          <SimplePredicate field="monthsInService" operator="greaterOrEqual" value="45"/>
        </Attribute>
      </Characteristic>
      <Characteristic name="EquipmentTypeScore" baselineScore="0.0" reasonCode="EQUIP">
        <Extension name="cellRef" value="$B$16"/>
        <Attribute partialScore="-10.0" reasonCode="CX2">
          <Extension name="description" value="presses and ovens have demanding duty cycles"/>
          <Extension name="cellRef" value="$C$18"/>
          <SimpleSetPredicate field="equipmentType" booleanOperator="isIn">
            <Array n="2" type="string">PRESS OVEN</Array>
          </SimpleSetPredicate>
        </Attribute>
        <Attribute partialScore="10.0">
          <Extension name="cellRef" value="$C$19"/>
          <SimpleSetPredicate field="equipmentType" booleanOperator="isIn">
            <Array n="2" type="string">PUMP COMPRESSOR</Array>
          </SimpleSetPredicate>
        </Attribute>
        <Attribute partialScore="5.0">
          <Extension name="cellRef" value="$C$20"/>
          <SimpleSetPredicate field="equipmentType" booleanOperator="isIn">
            <Array n="2" type="string">CONVEYOR GENERATOR</Array>
          </SimpleSetPredicate>
        </Attribute>
      </Characteristic>
      <Characteristic name="OperatingEnvironmentScore" baselineScore="0.0" reasonCode="ENV">
        <Extension name="cellRef" value="$B$22"/>
        <Attribute partialScore="-10.0">
          <Extension name="cellRef" value="$C$24"/>
          <SimplePredicate field="operatingEnvironment" operator="equal" value="OUTDOOR"/>
        </Attribute>
        <Attribute partialScore="10.0">
          <Extension name="cellRef" value="$C$25"/>
          <SimplePredicate field="operatingEnvironment" operator="equal" value="COASTAL"/>
        </Attribute>
        <Attribute partialScore="5.0">
          <Extension name="cellRef" value="$C$26"/>
          <SimplePredicate field="operatingEnvironment" operator="equal" value="INDOOR"/>
        </Attribute>
      </Characteristic>
      <Characteristic name="InspectionScore" baselineScore="0.0">
        <Extension name="cellRef" value="$B$28"/>
        <Attribute partialScore="1.0" reasonCode="INSPECTION">
          <Extension name="cellRef" value="$C$30"/>
          <SimplePredicate field="inspectionPassed" operator="equal" value="true"/>
        </Attribute>
        <Attribute partialScore="-1.0" reasonCode="INSPECTION">
          <Extension name="cellRef" value="$C$31"/>
          <SimplePredicate field="inspectionPassed" operator="equal" value="false"/>
        </Attribute>
      </Characteristic>
    </Characteristics>
  </Scorecard>
</PMML>
